<!--
Wazuh SOC Lab
Custom Active Response Configuration

Purpose:
Execute a simulated containment response when
SSH brute-force Rule 5712 is triggered.

This configuration does not block network traffic.

Add these elements inside an existing <ossec_config>
section in the Wazuh Manager configuration.
-->

<command>
  <name>soc-lab-response</name>
  <executable>soc-lab-response.py</executable>
  <timeout_allowed>no</timeout_allowed>
</command>

<active-response>
  <disabled>no</disabled>
  <command>soc-lab-response</command>
  <location>server</location>
  <rules_id>5712</rules_id>
</active-response>
